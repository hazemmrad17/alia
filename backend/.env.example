# ALIA Avatar Environment Variables

# Backend
APP_NAME=ALIA-Avatar
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=alia_avatar
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgresql

# LLM Provider: "groq" or "anthropic"
LLM_PROVIDER=groq

# Groq (free tier - recommended)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic Claude (freemium)
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# HeyGen Avatar (optional)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=alia_products

# Logging
LOG_LEVEL=INFO

# Authentication
JWT_SECRET=generate-with-python-c-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEFAULT_TENANT_ID=vital
AUTH_SEED_USERS=true
AUTH_SEED_ADMIN_EMAIL=admin@vital.tn
AUTH_SEED_ADMIN_PASSWORD=choose-a-strong-password
AUTH_SEED_MANAGER_EMAIL=manager@vital.tn
AUTH_SEED_MANAGER_PASSWORD=choose-a-strong-password
AUTH_SEED_DELEGATE_EMAIL=delegate@vital.tn
AUTH_SEED_DELEGATE_PASSWORD=choose-a-strong-password
